# Databases
POSTGRES_URL=postgresql://user:pass@host:5432/menos_it
ACADEMY_DATABASE_URL=postgresql://user:pass@academy-host:5432/mita_academy

# Main-site email
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-gmail@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=support@menositconsult.com
RECIPIENT_EMAIL=minnahmat50@gmail.com

# Academy email
ACADEMY_SMTP_HOST=smtp.gmail.com
ACADEMY_SMTP_PORT=587
ACADEMY_SMTP_USER=your-academy-gmail@gmail.com
ACADEMY_SMTP_PASS=your-academy-app-password
ACADEMY_SMTP_FROM=academy@menositconsult.com
ACADEMY_MNOTIFY_API_KEY=
ACADEMY_MNOTIFY_SENDER=

# Server and authentication
PORT=3000
NODE_ENV=development
SESSION_SECRET=change-this-to-a-long-random-string
ADMIN_PASSWORD=change-me-before-going-live

# Academy administrator (seeded only when no Academy staff accounts exist)
ACADEMY_ADMIN_EMAIL=academy@menositconsult.com
ACADEMY_ADMIN_PASSWORD=replace-with-a-long-unique-password

# Cloudflare R2 credentials (shared by both buckets)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Main-site media bucket; blank keeps images in PostgreSQL
R2_BUCKET=
R2_PUBLIC_BASE=

# Academy media bucket must differ from R2_BUCKET; no fallback is used
ACADEMY_R2_BUCKET=
ACADEMY_R2_PUBLIC_BASE=

# Private Academy certificate bucket (must not be publicly accessible)
ACADEMY_CERTIFICATE_R2_BUCKET=
